# Copy this file to frontend/.env (local dev) and set the equivalent in
# Vercel's project settings for production — see SUPABASE_MIGRATION.md.
#
# There is no VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY here on purpose:
# public snapshot files are read without credentials. Database queries and
# writes still go through FastAPI, which alone holds the service-role key.
# No Supabase credential is shipped to the browser.

# Your deployed backend URL (Render), or http://127.0.0.1:8000 for local dev.
VITE_API_BASE=http://127.0.0.1:8000

# Public read-only Storage URL, unverified for this production project.
VITE_SNAPSHOT_BASE_URL=https://bsucvxhvshvrwouupbct.supabase.co/storage/v1/object/public/snapshots
# Optional cache-buster; not a guarantee of CDN freshness.
# VITE_SNAPSHOT_BUCKET_SECONDS=30

# Navigation always uses the validated local graph; no server routing switch.
